@model MotoShop.ViewModels.Seller.AddVehicleViewModel

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container-fluid">

    <div class="row mb-3">
        <div class="col-md-12">
            <h2 class="fw-bold">
                <i class="bi bi-car-front-fill text-primary"></i>
                Add Vehicle
            </h2>
            <hr />
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- Vehicle Information -->

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <strong>Vehicle Information</strong>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="RegistrationNumber" class="form-label"></label>
                        <input asp-for="RegistrationNumber" class="form-control" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Category</label>
                        <select asp-for="VehicleCategoryId"
                                asp-items="Model.Categories"
                                class="form-select">
                            <option value="">Select Category</option>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Brand</label>
                        <select asp-for="VehicleBrandId"
                                asp-items="Model.Brands"
                                class="form-select">
                            <option value="">Select Brand</option>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Model</label>
                        <select asp-for="VehicleModelId"
                                asp-items="Model.Models"
                                class="form-select">
                            <option value="">Select Model</option>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="ManufacturingYear" class="form-label"></label>
                        <input asp-for="ManufacturingYear"
                               class="form-control"
                               type="number" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Fuel Type</label>
                        <select asp-for="FuelTypeId"
                                asp-items="Model.FuelTypes"
                                class="form-select">
                            <option value="">Select Fuel Type</option>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Transmission" class="form-label"></label>

                        <select asp-for="Transmission" class="form-select">
                            <option value="">Select Transmission</option>
                            <option>Manual</option>
                            <option>Automatic</option>
                            <option>AMT</option>
                            <option>CVT</option>
                            <option>DCT</option>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Color" class="form-label"></label>

                        <select asp-for="Color" class="form-select">
                            <option value="">Select Color</option>
                            <option>White</option>
                            <option>Black</option>
                            <option>Silver</option>
                            <option>Grey</option>
                            <option>Blue</option>
                            <option>Red</option>
                            <option>Brown</option>
                            <option>Green</option>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="KilometersDriven" class="form-label"></label>
                        <input asp-for="KilometersDriven"
                               class="form-control"
                               type="number" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Owners" class="form-label"></label>
                        <input asp-for="Owners"
                               class="form-control"
                               type="number" />
                    </div>

                </div>

            </div>

        </div>

        <!-- Auction Information -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white">
                <strong>Auction Details</strong>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="StartingPrice" class="form-label"></label>
                        <input asp-for="StartingPrice"
                               class="form-control"
                               type="number"
                               step="0.01" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ReservePrice" class="form-label"></label>
                        <input asp-for="ReservePrice"
                               class="form-control"
                               type="number"
                               step="0.01" />
                    </div>

                </div>

            </div>

        </div>

        <!-- Description -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-info text-white">
                <strong>Description</strong>
            </div>

            <div class="card-body">

                <textarea asp-for="Description"
                          class="form-control"
                          rows="6"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>

            </div>

        </div>

        <!-- Images -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-warning">
                <strong>Vehicle Images</strong>
            </div>

            <div class="card-body">
                <input asp-for="Images"
                       type="file"
                       class="form-control"
                       multiple
                       accept="image/*" />

                <small class="text-muted">
                    You can upload multiple vehicle images.
                </small>

            </div>

        </div>

        <div class="text-end">

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Back

            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-circle"></i>
                Submit Vehicle

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}