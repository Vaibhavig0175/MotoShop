@{
    ViewData["Title"] = "Seller Dashboard";
    Layout = "~/Areas/Seller/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                Seller Dashboard

            </h2>

            <p class="text-muted mb-0">

                Welcome back! Here's an overview of your vehicles and auctions.

            </p>

        </div>

        <a asp-area="Seller"
           asp-controller="Vehicles"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>

            Add Vehicle

        </a>

    </div>

    <!-- KPI Cards -->

    <div class="row g-4 mb-4">

        <div class="col-lg-3 col-md-6">

            <div class="card shadow border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Total Vehicles

                            </small>

                            <h2 class="fw-bold mt-2">

                                @ViewBag.TotalVehicles

                            </h2>

                        </div>

                        <div class="text-primary">

                            <i class="bi bi-car-front-fill fs-1"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card shadow border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Pending Approval

                            </small>

                            <h2 class="fw-bold mt-2 text-warning">

                                @ViewBag.PendingVehicles

                            </h2>

                        </div>

                        <div class="text-warning">

                            <i class="bi bi-hourglass-split fs-1"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card shadow border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Approved

                            </small>

                            <h2 class="fw-bold mt-2 text-success">

                                @ViewBag.ApprovedVehicles

                            </h2>

                        </div>

                        <div class="text-success">

                            <i class="bi bi-check-circle-fill fs-1"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card shadow border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Rejected

                            </small>

                            <h2 class="fw-bold mt-2 text-danger">

                                @ViewBag.RejectedVehicles

                            </h2>

                        </div>

                        <div class="text-danger">

                            <i class="bi bi-x-circle-fill fs-1"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Second Row -->

    <div class="row g-4 mb-4">

        <div class="col-lg-4">

            <div class="card shadow border-0">

                <div class="card-body text-center">

                    <i class="bi bi-hammer display-4 text-primary"></i>

                    <h5 class="mt-3">

                        Active Auctions

                    </h5>

                    <h1 class="fw-bold">

                        @ViewBag.ActiveAuctions

                    </h1>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow border-0">

                <div class="card-body text-center">

                    <i class="bi bi-trophy-fill display-4 text-success"></i>

                    <h5 class="mt-3">

                        Sold Vehicles

                    </h5>

                    <h1 class="fw-bold">

                        @ViewBag.SoldVehicles

                    </h1>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow border-0">

                <div class="card-body text-center">

                    <i class="bi bi-cash-stack display-4 text-warning"></i>

                    <h5 class="mt-3">

                        Total Earnings

                    </h5>

                    <h1 class="fw-bold text-success">

                        ₹ @ViewBag.TotalEarnings

                    </h1>

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="card shadow border-0 mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Quick Actions

            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-lg-3">

                    <a asp-area="Seller"
                       asp-controller="Vehicles"
                       asp-action="Create"
                       class="btn btn-outline-primary w-100">

                        <i class="bi bi-plus-circle"></i>

                        Add Vehicle

                    </a>

                </div>

                <div class="col-lg-3">

                    <a asp-area="Seller"
                       asp-controller="Vehicles"
                       asp-action="Index"
                       class="btn btn-outline-success w-100">

                        <i class="bi bi-car-front-fill"></i>

                        My Vehicles

                    </a>

                </div>

                <div class="col-lg-3">

                    <a asp-area="Seller"
                       asp-controller="Auctions"
                       asp-action="Index"
                       class="btn btn-outline-warning w-100">

                        <i class="bi bi-hammer"></i>

                        My Auctions

                    </a>

                </div>

                <div class="col-lg-3">

                    <a asp-area=""
                       asp-controller="Manage"
                       asp-action="Index"
                       class="btn btn-outline-dark w-100">

                        <i class="bi bi-person-circle"></i>

                        Profile

                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Information Cards -->

    <div class="row">

        <div class="col-lg-6">

            <div class="card shadow border-0">

                <div class="card-header bg-white">

                    <h5>

                        Approval Status Guide

                    </h5>

                </div>

                <div class="card-body">

                    <span class="badge bg-warning">

                        Pending

                    </span>

                    Waiting for Admin Approval

                    <hr />

                    <span class="badge bg-success">

                        Approved

                    </span>

                    Ready for Auction

                    <hr />

                    <span class="badge bg-danger">

                        Rejected

                    </span>

                    Please check rejection reason and update the vehicle.

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card shadow border-0">

                <div class="card-header bg-white">

                    <h5>

                        Seller Tips

                    </h5>

                </div>

                <div class="card-body">

                    <ul class="mb-0">

                        <li>Add high-quality vehicle images.</li>

                        <li>Provide an accurate description.</li>

                        <li>Set a realistic starting price.</li>

                        <li>Keep documents ready.</li>

                        <li>Monitor active auctions regularly.</li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>