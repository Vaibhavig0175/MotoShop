@model MotoShop.Models.Payment

@{
    Layout = "_BuyerLayout";
    ViewData["Title"] = "Payment Receipt";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-success text-white">

            <div class="d-flex justify-content-between">

                <div>

                    <h2>MotoShop</h2>

                    <small>Vehicle Auction Platform</small>

                </div>

                <div class="text-end">

                    <h4>PAYMENT RECEIPT</h4>

                    <small>#@Model.Id</small>

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-6">

                    <h5>Buyer</h5>

                    <p>

                        <strong>@Model.Buyer.FullName</strong><br />

                        @Model.Buyer.Email

                    </p>

                </div>

                <div class="col-md-6 text-end">

                    <h5>Seller</h5>

                    <p>

                        <strong>@Model.Auction.Vehicle.Seller.FullName</strong><br />

                        @Model.Auction.Vehicle.Seller.Email

                    </p>

                </div>

            </div>

            <table class="table table-bordered">

                <tr>

                    <th width="35%">Vehicle</th>

                    <td>

                        @Model.Auction.Vehicle.VehicleBrand.Name
                        @Model.Auction.Vehicle.VehicleModel.Name

                    </td>

                </tr>

                <tr>

                    <th>Winning Bid</th>

                    <td>

                        ₹ @Model.Amount.ToString("N0")

                    </td>

                </tr>

                <tr>

                    <th>Transaction ID</th>

                    <td>

                        @Model.TransactionId

                    </td>

                </tr>

                <tr>

                    <th>Payment Date</th>

                    <td>

                        @Model.PaymentDate

                    </td>

                </tr>

                <tr>

                    <th>Status</th>

                    <td>

                        <span class="badge bg-success">

                            @Model.Status

                        </span>

                    </td>

                </tr>

            </table>

            <div class="alert alert-success mt-4">

                <strong>

                    Payment Successful

                </strong>

                <br />

                Thank you for purchasing through MotoShop.

            </div>

            <div class="text-center mt-4">

                <button onclick="window.print()"
                        class="btn btn-primary">

                    <i class="bi bi-printer"></i>

                    Print Receipt

                </button>

            </div>

        </div>

    </div>

</div>