@model MotoShop.Models.Auction

@{
    ViewData["Title"] = "Auction Details";
    Layout = "~/Areas/Buyer/Views/Shared/_Layout.cshtml";

    var highestBid = ViewBag.HighestBid as MotoShop.Models.Bid;
    var bids = ViewBag.Bids as List<MotoShop.Models.Bid>;
}

<div class="container-fluid">

    <div class="row">

        <!-- LEFT -->

        <div class="col-lg-8">

            <!-- Images -->

            <div class="card shadow mb-4">

                <div class="card-body">

                    @if (Model.Vehicle.Images.Any())
                    {
                        <img id="mainImage"
                             src="@Model.Vehicle.Images.First().ImageUrl"
                             class="img-fluid rounded mb-3"
                             style="height:450px;width:100%;object-fit:cover;" />

                        <div class="row">

                            @foreach (var image in Model.Vehicle.Images)
                            {
                                <div class="col-3">

                                    <img src="@image.ImageUrl"
                                         class="img-thumbnail mb-2 thumb"
                                         style="height:90px;width:100%;object-fit:cover;cursor:pointer;" />

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <img src="~/images/no-image.png"
                             class="img-fluid rounded" />
                    }

                </div>

            </div>

            <!-- Vehicle -->

            <div class="card shadow">

                <div class="card-header">

                    <h4>

                        @Model.Vehicle.Title

                    </h4>

                </div>

                <div class="card-body">

                    <table class="table table-bordered">

                        <tr>

                            <th width="250">Brand</th>

                            <td>@Model.Vehicle.VehicleBrand.Name</td>

                        </tr>

                        <tr>

                            <th>Model</th>

                            <td>@Model.Vehicle.VehicleModel.Name</td>

                        </tr>

                        <tr>

                            <th>Category</th>

                            <td>@Model.Vehicle.VehicleCategory.Name</td>

                        </tr>

                        <tr>

                            <th>Fuel</th>

                            <td>@Model.Vehicle.FuelType.Name</td>

                        </tr>

                        <tr>

                            <th>Transmission</th>

                            <td>@Model.Vehicle.Transmission</td>

                        </tr>

                        <tr>

                            <th>Color</th>

                            <td>@Model.Vehicle.Color</td>

                        </tr>

                        <tr>

                            <th>Manufacturing Year</th>

                            <td>@Model.Vehicle.ManufacturingYear</td>

                        </tr>

                        <tr>

                            <th>KM Driven</th>

                            <td>@Model.Vehicle.KilometersDriven</td>

                        </tr>

                        <tr>

                            <th>Owners</th>

                            <td>@Model.Vehicle.Owners</td>

                        </tr>

                        <tr>

                            <th>Description</th>

                            <td>@Model.Vehicle.Description</td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- RIGHT -->

        <div class="col-lg-4">

            <div class="card shadow mb-4">

                <div class="card-header bg-primary text-white">

                    Auction Details

                </div>

                <div class="card-body">

                    <table class="table">

                        <tr>

                            <th>Starting Price</th>

                            <td>

                                ₹ @Model.StartingPrice.ToString("N0")

                            </td>

                        </tr>

                        <tr>

                            <th>Current Bid</th>

                            <td>

                                <div class="card shadow mb-3">

                                    <div class="card-body text-center">

                                        <h6>Current Highest Bid</h6>

                                        <h2 id="currentBid" class="text-success">

                                            ₹ @Model.CurrentBid.ToString("N0")

                                        </h2>

                                        <small id="highestBidder">

                                            Highest Bidder :
                                            @(ViewBag.HighestBid?.Buyer?.FullName ?? "No Bids")

                                        </small>

                                    </div>

                                </div>

                            </td>

                        </tr>

                        <tr>

                            <th>Highest Bidder</th>

                            <td>

                                @(highestBid?.Buyer?.FullName ?? "-")

                            </td>

                        </tr>

                        <tr>

                            <th>Ends</th>

                            <td>

                                @Model.EndDate.ToString("dd MMM yyyy hh:mm tt")

                            </td>

                        </tr>

                        <tr>

                            <th>Countdown</th>

                            <td>

                                <h3 id="countdown"></h3>

                            </td>

                        </tr>

                    </table>

                    <hr />

                    @if (Model.IsClosed)
                    {
                        <div class="alert alert-danger">

                            <h4>

                                <i class="bi bi-lock-fill"></i>

                                Auction Closed

                            </h4>

                            <hr />

                            <p>

                                This auction has ended.

                            </p>

                            @if (highestBid != null)
                            {
                                <h5 class="text-success">

                                    Winning Bid

                                </h5>

                                <h3>

                                    ₹ @highestBid.Amount.ToString("N0")

                                </h3>

                                <strong>

                                    Winner :

                                </strong>

                                @highestBid.Buyer.FullName
                            }
                            else
                            {
                                <h5>

                                    No bids were placed.

                                </h5>
                            }

                        </div>
                    }
                    else
                    {
                        <form asp-action="PlaceBid" method="post">

                            <input type="hidden"
                                   name="auctionId"
                                   value="@Model.Id" />

                            <div class="mb-3">

                                <label class="form-label">

                                    Your Bid

                                </label>

                                <input class="form-control form-control-lg"
                                       type="number"
                                       step="1"
                                       min="@(Model.CurrentBid + 1000)"
                                       name="amount"
                                       required />

                                <small class="text-muted">

                                    Minimum Bid :
                                    ₹ @(Model.CurrentBid + 1000)

                                </small>

                            </div>

                            <button class="btn btn-success btn-lg w-100">

                                <i class="bi bi-cash-stack"></i>

                                Place Bid

                            </button>

                        </form>
                    }

                </div>

            </div>

            <!-- Bid History -->

            <div class="card shadow">

                <div class="card-header bg-dark text-white">

                    Bid History

                </div>

                <div class="card-body p-0">

                    <table class="table table-striped mb-0">

                        <thead>

                            <tr>

                                <th>Buyer</th>

                                <th>Amount</th>

                                <th>Time</th>

                            </tr>

                        </thead>

                        <tbody id="bidHistory">

                            @foreach (var bid in ViewBag.BidHistory)
                            {
                                <tr>

                                    <td>

                                        @bid.Buyer.FullName

                                    </td>

                                    <td>

                                        ₹ @bid.Amount.ToString("N0")

                                    </td>

                                    <td>

                                        @bid.CreatedOn.ToString("HH:mm:ss")

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- Toast Notification -->

        <div class="position-fixed bottom-0 end-0 p-3"
             style="z-index:9999">

            <div id="bidToast"
                 class="toast">

                <div class="toast-header">

                    <strong>

                        Live Auction

                    </strong>

                </div>

                <div class="toast-body"
                     id="toastBody">
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const endDate = new Date("@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")");

        setInterval(function() {

            let diff = endDate - new Date();

            if (diff <= 0) {

                document.getElementById("countdown").innerHTML = "Auction Closed";

                return;

            }

            let h = Math.floor(diff / 1000 / 60 / 60);

            let m = Math.floor((diff / 1000 / 60) % 60);

            let s = Math.floor((diff / 1000) % 60);

            document.getElementById("countdown").innerHTML =

                `${h}h ${m}m ${s}s`;

        }, 1000);

        const auctionId = '@Model.Id';

        const connection = new signalR.HubConnectionBuilder()

            .withUrl("/auctionHub")

            .build();

        connection.start().then(function() {

            connection.invoke("JoinAuction", auctionId);

        });

        connection.on("ReceiveBid", function(data) {

            document.getElementById("currentBid").innerHTML =
                "₹ " + Number(data.amount).toLocaleString();

            document.getElementById("highestBidder").innerHTML =
                "Highest Bidder : " + data.buyer;

            let tbody = document.getElementById("bidHistory");
            let bidBox = document.querySelector("input[name='amount']");

            if (bidBox) {

                bidBox.value = "";

                bidBox.min = data.amount + 1000;

            }

            tbody.insertAdjacentHTML("afterbegin",

                `<tr>

                    <td>${data.buyer}</td>

                    <td>₹ ${Number(data.amount).toLocaleString()}</td>

                    <td>${data.time}</td>

                </tr>`);

            document.getElementById("toastBody").innerHTML =

                `${data.buyer} placed ₹ ${Number(data.amount).toLocaleString()}`;

            let toast = new bootstrap.Toast(

                document.getElementById("bidToast"));

            toast.show();

        });

        window.onbeforeunload = function() {

            connection.invoke("LeaveAuction", auctionId);

        };

        document.querySelectorAll(".thumb").forEach(function(img) {

            img.onclick = function() {

                document.getElementById("mainImage").src = this.src;

            };

        });

        function countdown() {

            let end = new Date("@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")");

            let now = new Date();

            let diff = end - now;

            if (diff <= 0) {

                location.reload();

            }

            if (diff < 0) {

                document.getElementById("countdown").innerHTML = "Auction Closed";

                return;

            }

            let d = Math.floor(diff / (1000 * 60 * 60 * 24));

            let h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));

            let m = Math.floor((diff % (1000 * 60 * 60)) / 60000);

            let s = Math.floor((diff % (60000)) / 1000);

            document.getElementById("countdown").innerHTML =

                d + "d " + h + "h " + m + "m " + s + "s";

        }

        countdown();

        setInterval(countdown, 1000);

        setInterval(function() {

            location.reload();

        }, 30000);

    </script>

}