@model IEnumerable<MotoShop.Models.Bid>

@{
    ViewData["Title"] = "My Bids";
    Layout = "~/Areas/Buyer/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>

            <i class="bi bi-cash-stack"></i>

            My Bids

        </h2>

    </div>

    <div class="card shadow">

        <div class="card-body">

            <table class="table table-hover table-striped align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>Image</th>

                        <th>Vehicle</th>

                        <th>My Bid</th>

                        <th>Current Bid</th>

                        <th>Status</th>

                        <th>Bid Time</th>

                        <th>Status</th>

                        <th></th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        var image = item.Auction.Vehicle.Images.FirstOrDefault()?.ImageUrl
                                    ?? "/images/no-image.png";

                        <tr>

                            <td width="110">

                                <img src="@image"
                                     class="rounded"
                                     style="width:90px;height:70px;object-fit:cover;" />

                            </td>

                            <td>

                                <strong>

                                    @item.Auction.Vehicle.VehicleBrand.Name
                                    @item.Auction.Vehicle.VehicleModel.Name

                                </strong>

                                <br />

                                <small class="text-muted">

                                    @item.Auction.Vehicle.ManufacturingYear

                                </small>

                            </td>

                            <td>

                                <span class="fw-bold text-primary">

                                    ₹ @item.Amount.ToString("N0")

                                </span>

                            </td>

                            <td>

                                <span class="fw-bold text-success">

                                    ₹ @item.Auction.CurrentBid.ToString("N0")

                                </span>

                            </td>

                            <td>

                                @if (item.IsWinningBid)
                                {
                                    <span class="badge bg-success">

                                        Winning

                                    </span>
                                }
                                else if (item.Auction.IsClosed)
                                {
                                    <span class="badge bg-secondary">

                                        Auction Closed

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">

                                        Out Bid

                                    </span>
                                }

                            </td>

                            <td>

                                @item.BidTime.ToString("dd MMM yyyy")

                                <br />

                                <small>

                                    @item.BidTime.ToString("hh:mm tt")

                                </small>

                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.AuctionId"
                                   class="btn btn-outline-primary btn-sm">

                                    <i class="bi bi-eye"></i>

                                    View

                                </a>

                            </td>

                            <td>

                                @if (item.IsWinningBid)
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-trophy-fill"></i>

                                        Winner

                                    </span>
                                }
                                else if (item.Auction.IsClosed)
                                {
                                    <span class="badge bg-danger">

                                        <i class="bi bi-x-circle-fill"></i>

                                        Lost

                                    </span>
                                }
                                else if (item.Amount == item.Auction.CurrentBid)
                                {
                                    <span class="badge bg-primary">

                                        <i class="bi bi-arrow-up-circle-fill"></i>

                                        Highest Bid

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">

                                        <i class="bi bi-clock-fill"></i>

                                        Out Bid

                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>