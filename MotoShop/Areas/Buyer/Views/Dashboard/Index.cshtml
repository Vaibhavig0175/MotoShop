@{
    ViewData["Title"] = "Buyer Dashboard";
    Layout = "~/Areas/Buyer/Views/Shared/_Layout.cshtml";
}

<div class="row g-4">

    <div class="col-md-3">

        <div class="card shadow text-center">

            <div class="card-body">

                <h5>My Bids</h5>

                <h2>@ViewBag.TotalBids</h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow text-center">

            <div class="card-body">

                <h5>Active Bids</h5>

                <h2>@ViewBag.ActiveBids</h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow text-center">

            <div class="card-body">

                <h5>Won Auctions</h5>

                <h2>@ViewBag.WonAuctions</h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow text-center">

            <div class="card-body">

                <h5>Purchased</h5>

                <h2>@ViewBag.PurchasedVehicles</h2>

            </div>

        </div>

    </div>

</div>

<div class="card shadow mt-4">

    <div class="card-header">

        <h5 class="mb-0">

            Welcome to MotoShop Buyer Dashboard

        </h5>

    </div>

    <div class="card-body">

        <p>

            Use the left navigation to browse live auctions, place bids,
            and track your auction activity.

        </p>

    </div>

</div>