@model MotoShop.Areas.Admin.Models.DashboardViewModel;

@{
    ViewData["Title"] = " Admin Dashboard";
}

<div class="container-fluid">

    <partial name="_DashboardCards" model="Model"/>

    <div class="row mt-4">

        <div class="col-lg-8">

            <partial name="_RevenueChart"/>

        </div>

        <div class="col-lg-4">

            <partial name="_AuctionChart"/>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-lg-8">

            <partial name="_LatestAuctions"/>

        </div>

        <div class="col-lg-4">

            <partial name="_RecentActivities"/>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-lg-6">

            <partial name="_RecentVehicles"/>

        </div>

        <div class="col-lg-6">

            <partial name="_RecentUsers"/>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-lg-6">

            <partial name="_QuickActions"/>

        </div>

        <div class="col-lg-6">

            <partial name="_SystemStatus"/>

        </div>

    </div>

</div>