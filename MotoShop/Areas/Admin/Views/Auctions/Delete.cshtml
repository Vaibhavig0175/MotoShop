@model MotoShop.Models.Auction;

@{
    ViewData["Title"] = "Delete Auction";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow border-0">

                <div class="card-header bg-danger text-white">

                    <h3>

                        <i class="bi bi-trash"></i>

                        Delete Auction

                    </h3>

                </div>

                <div class="card-body">

                    <div class="alert alert-danger">

                        <h5>

                            Are you sure you want to delete this auction?

                        </h5>

                    </div>

                    <table class="table">

                        <tr>

                            <th>Vehicle</th>

                            <td>

                                @Model.Vehicle.VehicleBrand.Name
                                @Model.Vehicle.VehicleModel.Name

                            </td>

                        </tr>

                        <tr>

                            <th>Starting Price</th>

                            <td>

                                ₹ @Model.StartingPrice

                            </td>

                        </tr>

                        <tr>

                            <th>Current Bid</th>

                            <td>

                                ₹ @Model.CurrentBid

                            </td>

                        </tr>

                        <tr>

                            <th>Start</th>

                            <td>

                                @Model.StartTime

                            </td>

                        </tr>

                        <tr>

                            <th>End</th>

                            <td>

                                @Model.EndTime

                            </td>

                        </tr>

                        <tr>

                            <th>Status</th>

                            <td>

                                <span class="badge bg-info">

                                    @Model.Status

                                </span>

                            </td>

                        </tr>

                    </table>

                    <form asp-action="Delete">

                        <input type="hidden"
                               asp-for="Id" />

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                        <button class="btn btn-danger float-end"
                                type="submit">

                            <i class="bi bi-trash"></i>

                            Delete Auction

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>