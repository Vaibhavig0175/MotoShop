@model MotoShop.Models.Auction

@{
    ViewData["Title"] = "Delete Auction";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-danger">

                <div class="card-header bg-danger text-white">

                    <h4 class="mb-0">

                        <i class="bi bi-trash"></i>

                        Delete Auction

                    </h4>

                </div>

                <div class="card-body">

                    <div class="alert alert-danger">

                        <h5>

                            Are you sure you want to delete this auction?

                        </h5>

                        <p class="mb-0">

                            This action cannot be undone.

                        </p>

                    </div>

                    <table class="table table-bordered">

                        <tr>

                            <th width="250">

                                Vehicle

                            </th>

                            <td>

                                @Model.Vehicle?.VehicleBrand?.Name
                                @Model.Vehicle?.VehicleModel?.Name

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Title

                            </th>

                            <td>

                                @Model.Vehicle?.Title

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Starting Price

                            </th>

                            <td>

                                ₹ @Model.StartingPrice.ToString("N0")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Current Bid

                            </th>

                            <td>

                                ₹ @Model.CurrentBid.ToString("N0")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Start Date

                            </th>

                            <td>

                                @Model.StartDate.ToString("dd MMM yyyy hh:mm tt")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                End Date

                            </th>

                            <td>

                                @Model.EndDate.ToString("dd MMM yyyy hh:mm tt")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Status

                            </th>

                            <td>

                                @if (Model.IsClosed)
                                {
                                    <span class="badge bg-secondary">

                                        Closed

                                    </span>
                                }
                                else if (Model.StartDate > DateTime.Now)
                                {
                                    <span class="badge bg-info">

                                        Upcoming

                                    </span>
                                }
                                else if (Model.EndDate < DateTime.Now)
                                {
                                    <span class="badge bg-dark">

                                        Completed

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">

                                        Live

                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                    <form asp-action="Delete">

                        <input asp-for="Id" type="hidden" />

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-trash"></i>

                                Delete Auction

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>