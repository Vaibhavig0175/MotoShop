@model MotoShop.Areas.Admin.Models.AuctionDashboardViewModel

@{
    ViewData["Title"] = "Auction Management";
}

<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Auction Management
            </h2>

            <small class="text-muted">
                Manage all vehicle auctions from one place.
            </small>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>

            Create Auction

        </a>

    </div>

    <!-- Dashboard Cards -->

    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Total Auctions

                            </small>

                            <h2 class="fw-bold">

                                @Model.TotalAuctions

                            </h2>

                        </div>

                        <i class="bi bi-hammer text-primary fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Upcoming

                            </small>

                            <h2 class="fw-bold text-warning">

                                @Model.UpcomingAuctions

                            </h2>

                        </div>

                        <i class="bi bi-clock-history text-warning fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Live

                            </small>

                            <h2 class="fw-bold text-success">

                                @Model.LiveAuctions

                            </h2>

                        </div>

                        <i class="bi bi-broadcast text-success fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Closed

                            </small>

                            <h2 class="fw-bold text-danger">

                                @Model.ClosedAuctions

                            </h2>

                        </div>

                        <i class="bi bi-check-circle text-danger fs-1"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Search -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <input type="text"
                           id="searchBox"
                           class="form-control"
                           placeholder="Search vehicle, seller or status..." />

                </div>

            </div>

        </div>

    </div>

    <!-- Auction Table -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="auctionTable">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>

                            <th>Vehicle</th>

                            <th>Seller</th>

                            <th>Starting Price</th>

                            <th>Current Bid</th>

                            <th>Start</th>

                            <th>End</th>

                            <th>Status</th>

                            <th width="220">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Auctions)
                        {
                            <tr>

                                <td>

                                    @item.Id

                                </td>

                                <td class="fw-semibold">

                                    @item.VehicleName

                                </td>

                                <td>

                                    @item.SellerName

                                </td>

                                <td>

                                    ₹ @item.StartingPrice.ToString("N0")

                                </td>

                                <td class="text-success fw-bold">

                                    ₹ @item.CurrentBid.ToString("N0")

                                </td>

                                <td>

                                    @item.StartTime.ToString("dd MMM yyyy")

                                    <br />

                                    <small class="text-muted">

                                        @item.StartTime.ToString("hh:mm tt")

                                    </small>

                                </td>

                                <td>

                                    @item.EndTime.ToString("dd MMM yyyy")

                                    <br />

                                    <small class="text-muted">

                                        @item.EndTime.ToString("hh:mm tt")

                                    </small>

                                </td>

                                <td>

                                    @if (item.Status == "Upcoming")
                                    {
                                        <span class="badge bg-warning">

                                            Upcoming

                                        </span>
                                    }
                                    else if (item.Status == "Live")
                                    {
                                        <span class="badge bg-success">

                                            Live

                                        </span>
                                    }
                                    else if (item.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary">

                                            Closed

                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">

                                            Cancelled

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">

                                            @item.Status

                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts{

<script>

document.getElementById("searchBox").addEventListener("keyup", function () {

    var value = this.value.toLowerCase();

    var rows = document.querySelectorAll("#auctionTable tbody tr");

    rows.forEach(function (row) {

        row.style.display =
            row.innerText.toLowerCase().includes(value)
                ? ""
                : "none";

    });

});

</script>

}