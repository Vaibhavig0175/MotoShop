@using MotoShop.Enums
@model MotoShop.Models.Auction;

@{
    ViewData["Title"] = "Auction Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">

            Auction Details

        </h2>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="bi bi-pencil"></i>

                Edit

            </a>

            @if (Model.Status == AuctionStatus.Upcoming)
            {
                <a asp-action="Start"
                   asp-route-id="@Model.Id"
                   class="btn btn-success">

                    <i class="bi bi-play-fill"></i>

                    Start Auction

                </a>
            }
            @if (Model.Status == AuctionStatus.Live)
            {
                <a asp-action="Close"
                   asp-route-id="@Model.Id"
                   class="btn btn-danger">

                    <i class="bi bi-stop-fill"></i>

                    Close Auction

                </a>
            }

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

    <div class="row">

        <!-- LEFT -->

        <div class="col-lg-8">

            <!-- Gallery -->

            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    Vehicle Images

                </div>

                <div class="card-body">

                    @if (Model.Vehicle.Images.Any())
                    {
                        <div class="row">

                            @foreach (var img in Model.Vehicle.Images)
                            {
                                <div class="col-md-4 mb-3">

                                    <img src="@img.ImageUrl"
                                         class="img-fluid rounded shadow-sm"
                                         style="height:220px;width:100%;object-fit:cover;" />

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <img src="/images/no-image.png"
                             class="img-fluid rounded" />
                    }

                </div>

            </div>

            <!-- Vehicle -->

            <div class="card shadow-sm">

                <div class="card-header">

                    Vehicle Information

                </div>

                <div class="card-body">

                    <table class="table table-bordered">

                        <tr>

                            <th width="30%">Title</th>

                            <td>@Model.Vehicle.Title</td>

                        </tr>

                        <tr>

                            <th>Category</th>

                            <td>@Model.Vehicle.VehicleCategory.Name</td>

                        </tr>

                        <tr>

                            <th>Brand</th>

                            <td>@Model.Vehicle.VehicleBrand.Name</td>

                        </tr>

                        <tr>

                            <th>Model</th>

                            <td>@Model.Vehicle.VehicleModel.Name</td>

                        </tr>

                        <tr>

                            <th>Year</th>

                            <td>@Model.Vehicle.ManufacturingYear</td>

                        </tr>

                        <tr>

                            <th>Fuel</th>

                            <td>@Model.Vehicle.FuelType.Name</td>

                        </tr>

                        <tr>

                            <th>KM Driven</th>

                            <td>@Model.Vehicle.KilometersDriven</td>

                        </tr>

                        <tr>

                            <th>Registration</th>

                            <td>@Model.Vehicle.RegistrationNumber</td>

                        </tr>

                        <tr>

                            <th>Description</th>

                            <td>@Model.Vehicle.Description</td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <!-- RIGHT -->

        <div class="col-lg-4">

            <!-- Auction -->

            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    Auction Information

                </div>

                @if (Model.Status == AuctionStatus.Closed)
                {
                    <div class="card shadow-sm mt-4">

                        <div class="card-header bg-success text-white">

                            Auction Result

                        </div>

                        <div class="card-body">

                            @if (Model.Winner != null)
                            {
                                <h5>Winner</h5>

                                <h3 class="text-success">

                                    @Model.Winner.FullName

                                </h3>

                                <hr />

                                <h5>Winning Bid</h5>

                                <h2>

                                    ₹ @Model.WinningBidAmount?.ToString("N0")

                                </h2>

                                <hr />

                                <h6>

                                    Closed On

                                </h6>

                                <span>

                                    @Model.ClosedOn

                                </span>
                            }
                            else
                            {
                                <div class="alert alert-warning">

                                    No bids were received.

                                </div>
                            }

                        </div>

                    </div>
                }

                <div class="card-body">

                    <table class="table">

                        <tr>

                            <th>Status</th>

                            <td>

                                <span class="badge bg-success">

                                    @Model.Status

                                </span>

                            </td>

                        </tr>

                        <tr>

                            <th>Starting Price</th>

                            <td>

                                ₹ @Model.StartingPrice

                            </td>

                        </tr>

                        <tr>

                            <th>Current Bid</th>

                            <td class="text-success fw-bold">

                                ₹ @Model.CurrentBid

                            </td>

                        </tr>

                        <tr>

                            <th>Reserve Price</th>

                            <td>

                                ₹ @Model.ReservePrice

                            </td>

                        </tr>

                        <tr>

                            <th>Start</th>

                            <td>

                                @Model.StartTime

                            </td>

                        </tr>

                        <tr>

                            <th>End</th>

                            <td>

                                @Model.EndTime

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

            <!-- Seller -->

            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    Seller Information

                </div>

                <div class="card-body">

                    <table class="table">

                        <tr>

                            <th>Name</th>

                            <td>@Model.Vehicle.Seller.FullName</td>

                        </tr>

                        <tr>

                            <th>Email</th>

                            <td>@Model.Vehicle.Seller.Email</td>

                        </tr>

                        <tr>

                            <th>Phone</th>

                            <td>@Model.Vehicle.Seller.PhoneNumber</td>

                        </tr>

                    </table>

                </div>

            </div>

            <!-- Bids -->

            <div class="card shadow-sm">

                <div class="card-header">

                    Bid History

                </div>

                <div class="card-body">

                    @if (Model.Bids.Any())
                    {
                        <table class="table table-sm">

                            <thead>

                                <tr>

                                    <th>Buyer</th>

                                    <th>Bid</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var bid in Model.Bids.OrderByDescending(x => x.BidTime))
                                {
                                    <tr>

                                        <td>

                                            @bid.Buyer.FullName

                                        </td>

                                        <td>

                                            ₹ @bid.Amount

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p class="text-muted">

                            No bids yet.

                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>