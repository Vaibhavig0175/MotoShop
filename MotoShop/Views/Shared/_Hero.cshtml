<section class="hero-section text-white">

    <div class="hero-overlay">

        <div class="container">

            <div class="row align-items-center" style="min-height:650px;">

                <div class="col-lg-7">

                    <h1 class="display-3 fw-bold">

                        Buy. Sell. Bid.

                    </h1>

                    <h2 class="mb-4">

                        India's Smart Vehicle Auction Marketplace

                    </h2>

                    <p class="lead">

                        Discover quality vehicles, participate in live auctions,
                        and connect with verified buyers and sellers across India.

                    </p>

                    <div class="mt-4">

                        <a asp-controller="Account"
                           asp-action="RegisterBuyer"
                           class="btn btn-primary btn-lg me-3">

                            Register as Buyer

                        </a>

                        <a asp-controller="Account"
                           asp-action="RegisterSeller"
                           class="btn btn-success btn-lg">

                            Register as Seller

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>