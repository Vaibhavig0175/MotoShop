<section class="py-5">

    <div class="row">

        <div class="col-lg-6">

            <div class="card border-primary shadow">

                <div class="card-body text-center">

                    <h3>Become a Buyer</h3>

                    <p>

                        Browse thousands of vehicles,
                        participate in live auctions,
                        and purchase your dream vehicle.

                    </p>

                    <a asp-controller="Account"
                       asp-action="RegisterBuyer"
                       class="btn btn-primary">

                        Register as Buyer

                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card border-success shadow">

                <div class="card-body text-center">

                    <h3>Become a Seller</h3>

                    <p>

                        List your vehicles,
                        reach thousands of buyers,
                        and maximize your selling price.

                    </p>

                    <a asp-controller="Account"
                       asp-action="RegisterSeller"
                       class="btn btn-success">

                        Register as Seller

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>